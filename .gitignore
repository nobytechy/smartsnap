# ── Node / Vite frontend ──────────────────────────────────────────
node_modules/
**/dist/
.vite/
*.log

# ── Env files (NEVER commit) ──────────────────────────────────────
.env
.env.local
.env.*.local
**/api/.env

# ── Python backend ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# ── Frigate runtime data (videos, snapshots, db, model cache) ─────
backend/frigate/media/
# Everything in frigate/config/ is runtime state — ONLY the user-edited
# config.yml is tracked. Frigate (re)generates the rest at boot.
backend/frigate/config/*
!backend/frigate/config/config.yml
backend/mosquitto/data/
backend/mosquitto/log/

# ── Local helper binaries ─────────────────────────────────────────
backend/tools/

# ── Editors / OS ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Misc build artefacts ──────────────────────────────────────────
*.pid
*.sock
coverage/
