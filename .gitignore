backend/frigate/media/
backend/frigate/config/model_cache/
backend/frigate/config/config.yml.backup
backend/frigate/config/.streams.json
backend/frigate/config/.timeline.db*
backend/mosquitto/data/
backend/mosquitto/log/

# ── Local helper binaries ─────────────────────────────────────────
backend/tools/

