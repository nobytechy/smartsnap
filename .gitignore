# ── Node / Vite frontend ──────────────────────────────────────────
node_modules/
**/dist/
.vite/
*.log

# ── Env files (NEVER commit) ──────────────────────────────────────
.env
.env.local
.env.*.local
**/api/.env

# ── Python backend ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

